      10("<div style='font-weight: bold'>src.base64urlDecode</div><div style='font-size: 70%; margin-top: 0px'>[Component: function]</div><div style='font-size: 80%; margin-top:10px'>Decode a base64url string to<br />bytes. Accepts strings with<br />or without padding. Throws on<br />non-base64url characters.</div>")
