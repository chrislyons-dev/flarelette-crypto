{
  "name": "@flarelette/crypto-env",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "archlette": "npx archlette all -f docs/archlette.config.yaml",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p packages/flarelette-crypto-ts/tsconfig.json",
    "prepare": "husky",
    "check": "npm run lint && npm run typecheck && npm run archlette && npm run format && npm run test:coverage"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^4.0.4",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.6",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.4",
    "@chrislyons-dev/archlette": "^1.3.2",
    "fake-indexeddb": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
